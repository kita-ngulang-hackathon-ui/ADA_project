# =============================================================================
# [PROJECT NAME TBD] — console (Next.js) environment configuration
# Copy to .env.local. Every value below already works for a local demo:
#   cp .env.example .env.local && npm install && npm run dev
#
# The console still renders lib/mock-data.ts; lib/api.ts is not implemented
# yet, so NEXT_PUBLIC_API_BASE_URL is read by nothing until it is. Point it
# at the backend now so no page has to change later.
#
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time, so
# never put a secret here. The console talks only to the backend's
# /console/v1 surface; it has no database access of its own.
# Backend configuration lives in ../backend/.env.example.
# =============================================================================

# Origin of the deployed backend API, no trailing slash. The backend must list
# this app's own origin in API_CORS_ORIGINS or the browser blocks every call.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME=ADA
NEXT_PUBLIC_SYNTHETIC_DATA_BANNER=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo-wallet
