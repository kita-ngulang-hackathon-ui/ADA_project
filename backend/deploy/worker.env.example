# Read by deploy/ada-worker.service as an EnvironmentFile, on top of .env.
# Copy to deploy/worker.env and chmod 600 — it holds the app_worker password.
#
# Its only job is to point DATABASE_URL at the app_worker role. The worker
# inherits everything else from .env. Leave this unset and the worker runs the
# pipeline as app_console, which defeats the row-level security installed by
# migration 0006 and the approval separation guarded by
# tests/invariants/test_worker_role_cannot_approve.py.
#
# systemd EnvironmentFile syntax: no `export`, no shell expansion, no inline
# comments after a value.

DATABASE_URL=postgresql+psycopg://app_worker:change-me-worker@localhost:5432/retention
