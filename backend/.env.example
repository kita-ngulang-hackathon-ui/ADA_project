# =============================================================================
# [PROJECT NAME TBD] — BACKEND environment configuration
# Quick start on a fresh clone:
#   cp .env.example .env && docker compose up -d postgres && make migrate
# Every value below already works for a local demo as written. Nothing here
# has to be edited to get the API, the worker and the tests running.
#
# EXPLAIN_LLM_* ships pointed at the shared demo Qwen3-8B and is on. Verify it
# with `make check-llm`; if that endpoint is down, narration falls back to the
# deterministic template on its own and the pipeline still completes.
# TABPFN_TOKEN is still opt-in (empty = sklearn stand-in).
#
# Before anything leaves a laptop, replace every password and every
# replace-with-openssl-rand-hex-32 below: openssl rand -hex 32
# Values still marked __TBD__ are OPEN DECISIONS from REQUIREMENTS §6; the
# application fails loudly at startup rather than inventing a number.
#
# This file must live next to the Makefile, and both the API and the worker
# must be started with this directory as the working directory — they load
# .env relative to the CWD, not relative to their own source.
# The console's NEXT_PUBLIC_* values are in ../frontend/.env.example.
# =============================================================================

# --- Runtime ---
APP_ENV=local                       # local | ci | demo
LOG_LEVEL=INFO
OFFLINE_MODE=true                   # hard-fails any outbound call except the two optional adapters
TZ_DISPLAY=Asia/Jakarta             # storage is always UTC

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=retention
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
# The API uses both: console routes on DATABASE_URL, ingestion routes and
# delivery acks on WORKER_DATABASE_URL (the only role granted those writes).
DATABASE_URL=postgresql+psycopg://app_console:change-me-console@postgres:5432/retention
WORKER_DATABASE_URL=postgresql+psycopg://app_worker:change-me-worker@postgres:5432/retention
READONLY_DATABASE_URL=postgresql+psycopg://app_readonly:change-me-readonly@postgres:5432/retention
# Alembic only. Migration 0001 creates the app_console / app_worker /
# app_readonly roles, so migrations need a superuser DSN — none of the three
# DSNs above can run them. If unset, migrations/env.py falls back to building
# one from POSTGRES_HOST/PORT/DB/USER/PASSWORD above.
MIGRATE_DATABASE_URL=postgresql+psycopg://postgres:change-me-local@postgres:5432/retention
APP_CONSOLE_DB_PASSWORD=change-me-console
APP_WORKER_DB_PASSWORD=change-me-worker
APP_READONLY_DB_PASSWORD=change-me-readonly
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
# Comma-separated. Must list the deployed console's exact origin (scheme, host,
# port) once the frontend is hosted elsewhere, or the browser blocks every
# /console/v1 call.
API_CORS_ORIGINS=http://localhost:3000
API_REQUEST_TIMEOUT_SECONDS=15
INGEST_MAX_BATCH_SIZE=500
INGEST_RATE_LIMIT_PER_MIN=1000
CONSOLE_RATE_LIMIT_PER_MIN=300

# --- Secrets ---
PSEUDONYM_HMAC_SECRET=replace-with-openssl-rand-hex-32
MEASUREMENT_HMAC_SECRET=replace-with-openssl-rand-hex-32
CONSOLE_SESSION_SECRET=replace-with-openssl-rand-hex-32
API_KEY_HASH_PEPPER=replace-with-openssl-rand-hex-32

# --- Demo tenant API keys ---
INGEST_API_KEY_WALLET_DEMO=demo-wallet-key-change-me
INGEST_API_KEY_LENDING_DEMO=demo-lending-key-change-me

# --- Console reviewer identities (requirement 8; never defaulted) ---
CONSOLE_DEMO_REVIEWERS=ops_reviewer_1,ops_reviewer_2
CONSOLE_REQUIRE_REVIEWER_ID=true
CONSOLE_SESSION_TTL_SECONDS=43200   # 12h; the cookie carries its own expiry

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=500
WORKER_MAX_RETRIES=3
WORKER_STALE_CLAIM_SECONDS=120

# --- External signals (requirement 2) ---
EXTERNAL_SIGNAL_SOURCE=canned            # canned | live  (OPEN DECISION §6)
EXTERNAL_SIGNAL_FIXTURE_DIR=fixtures/external
EXTERNAL_SIGNAL_LIVE_BASE_URL=__TBD__
EXTERNAL_SIGNAL_SCOPE=CLIENT,REGION,COHORT
EXTERNAL_SIGNAL_MAX_AGE_DAYS=14
EXTERNAL_SIGNAL_LIVE_TIMEOUT_S=3        # live feed timeout before falling back to snapshot/canned

# --- Pipeline / graph (requirement 4) ---
PIPELINE_GRAPH_LOOKBACK_DAYS=90
PIPELINE_ACTIVITY_WINDOW_DAYS=30
PIPELINE_MIN_EDGE_INTERACTIONS=3
PIPELINE_CIRCLE_MIN_SIZE=3
PIPELINE_EDGE_DECAY_HALFLIFE_DAYS=21
PATTERN_DIP_THRESHOLD=0.10
PATTERN_COHORT_DIP_THRESHOLD=0.30
PIPELINE_GRAPH_PROFILES=WALLET           # profile types that get the graph stage; LENDING is an OPEN DECISION (§6)
PIPELINE_BUSINESS_VALUE_MONTHS=3         # business value = 30-day IDR volume x months

# --- TabPFN ---
TABPFN_ENABLED=true                      # false = sklearn stand-in only (TabPFN weights still being trained)
TABPFN_DEVICE=cpu
TABPFN_MODEL_CACHE_DIR=/models/tabpfn
TABPFN_SEED=42
TABPFN_MAX_CONTEXT_ROWS=1000
RISK_MIN_CONTEXT_ROWS=30                 # below this, churn risk uses a labeled heuristic

# --- Trained TabPFN churn scorer (TABPFN_CHURN_SCORER_INTEGRATION.md) ---
CHURN_SCORER_ENABLED=true                # true = artifact scorer must load or the worker refuses to start
CHURN_SCORER_ARTIFACT_DIR=artifacts      # synthetic_churn_context.parquet + context_schema.json + run_metadata.json
CHURN_SCORER_DEVICE=auto                 # auto | cuda | cpu
CHURN_SCORER_VERIFY_HASHES=true
CHURN_SCORER_ALLOW_CPU_LARGE_CONTEXT=true  # CPU only: allow the ~9k-row context (slower than GPU)
CHURN_SCORER_MAPPING_PATH=fixtures/churn_scorer_mapping.json
TABPFN_TOKEN=                            # SECRET: from ux.priorlabs.ai; never commit a real value

# --- Intervention Impact Engine (requirement 6) ---
IMPACT_SEED=42
IMPACT_MIN_TRAIN_ROWS=200
IMPACT_THRESHOLD=0.05
IMPACT_SURE_THING_P_NOT_INCENTIVIZED=0.80

# --- Decision Engine: ranker + allocator (requirement 7) ---
RANKER_MIN_CONTEXT_ROWS=100
ALLOCATOR_STRATEGY=auto                  # auto | exact_dp | greedy_density
ALLOCATOR_COST_SCALE_IDR=1000
ALLOCATOR_MAX_DP_CELLS=20000000
DEFAULT_BUDGET_IDR=5000000

# --- Policy guard (requirement 7 stage 1) ---
# Demo defaults so the guard passes out of the box. Still an OPEN DECISION §6:
# confirm both numbers with the client before any real deploy. Unset (__TBD__)
# makes the guard fail closed and every candidate is excluded.
FREQUENCY_CAP_MAX_CONTACTS=3
FREQUENCY_CAP_WINDOW_DAYS=14
RESPONSIBLE_LENDING_LOOKBACK_DAYS=60
RESPONSIBLE_LENDING_MIN_LATE_EVENTS=1
POLICY_FAIL_CLOSED=true

# --- Explanation / LLM (requirement 9) ---
# Any OpenAI-compatible /chat/completions endpoint. The narrator may only
# rephrase computed facts; the validator rejects any number or identifier that
# is not in the fact sheet, and a rejection silently falls back to the template.
#
# The values below point at the shared demo Qwen3-8B, reached through a
# notebook tunnel. They are demo credentials for a throwaway box, kept here on
# purpose so a clone runs with no extra setup -- not a pattern to copy for a
# real deployment, where these belong in .env and in a secret store only.
# Set EXPLAIN_LLM_ENABLED=false for template-only narration.
#
# Two separate credentials: `token=` in the URL authenticates the tunnel,
# EXPLAIN_LLM_API_KEY is the llama.cpp --api-key. The session id in the path
# changes when the notebook restarts; narration then falls back to TEMPLATE
# until the URL here is updated.
#
# Qwen3-8B on the same VM (qwen3-8b-backend-bundle/setup.sh):
#   EXPLAIN_LLM_BASE_URL=http://127.0.0.1:8000/v1
#   EXPLAIN_LLM_API_KEY=$(sed -n 's/^API_KEY=//p' qwen3-8b-backend-bundle/.env)
#
# Port collision: a local bundle serves on 8000, which is also this API's
# default port. On a single VM change one of them — set API_PORT above to
# 8001, or serve Qwen on another port and change the base URL here.
EXPLAIN_LLM_ENABLED=true                 # false = template explanations only (offline demo)
EXPLAIN_LLM_BASE_URL=http://103.67.43.241:9100/respati/9539926c-f3f4-4566-a2ac-084fbd80bf6c/proxy/8000/v1?token=ba376fdf-dc6c-47c8-a668-e3c4d4ae60e0
EXPLAIN_LLM_MODEL=qwen3-8b               # id from GET <base-url>/models
EXPLAIN_LLM_API_KEY=990eb17e33ec7a695263f44187cc5f555a768652d19acaf9
EXPLAIN_LLM_TIMEOUT_S=60                 # a hosted API needs ~6s; a local 8B on CPU needs this much
EXPLAIN_LLM_TEMPERATURE=0
EXPLAIN_LLM_MAX_TOKENS=220
# JSON merged into the request body, for provider-specific fields. Qwen3 needs
# enable_thinking=false: its <think> block invents numbers, and the whole
# 220-token budget goes to the scratchpad instead of the narration.
EXPLAIN_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# --- Measurement (requirement 10) ---
MEASUREMENT_CONTROL_PCT=20
MEASUREMENT_NAIVE_PCT=20
MEASUREMENT_NAIVE_RISK_THRESHOLD=0.60
MEASUREMENT_OBSERVATION_WINDOW_DAYS=14
MEASUREMENT_MIN_ARM_SIZE=30

# --- Continual improvement (requirement 11) ---
FEEDBACK_USE_IN_CONTEXT=true
FEEDBACK_MIN_ROWS_PER_CYCLE=10

# --- Synthetic data (SYNTHETIC_DATA.md) ---
SYNTHETIC_SEED=20260917
SYNTHETIC_WALLET_USERS=2000
SYNTHETIC_LENDING_USERS=1200
SYNTHETIC_DAYS_HISTORY=180
SYNTHETIC_REGIONS=6
SYNTHETIC_COHORTS=8
SYNTHETIC_PRIOR_CYCLES=3
